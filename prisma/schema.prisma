generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id          String    @id @default(cuid())
  name        String
  type        String
  description String
  pricePerNight Int   // mantengo el nombre por simplicidad — es el precio del turno base
  capacity    Int
  amenities   String
  imageUrl    String
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])

  // Tipo de reserva: "turno" o "pernocte"
  type        String

  // Fecha del día (sin hora)
  date        DateTime

  // Horarios — para turno usamos startTime/endTime del día.
  // Para pernocte, startTime es del día y endTime puede ser del día siguiente (caso dom-jue).
  startTime   String   // HH:mm
  endTime     String   // HH:mm
  durationHours Int    // 2, 3 o 12 (pernocte)

  guestName   String
  guestEmail  String
  guestPhone  String
  totalPrice  Int
  depositPaid Int
  status      String   @default("confirmed")
  notes       String?
  createdAt   DateTime @default(now())

  @@index([roomId, date])
}
